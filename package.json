{
  "name": "next-level-automation",
  "version": "1.0.0",
  "description": "AI-assisted automation framework foundation with Playwright UI, API, and BDD-oriented scaffolding.",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bddgen": "bddgen",
    "test": "npm run bddgen && playwright test",
    "test:smoke": "playwright test tests/smoke --project=core",
    "test:api": "playwright test tests/api --project=core",
    "test:ui": "playwright test tests/smoke --project=core",
    "test:bdd": "npm run bddgen && playwright test --project=bdd",
    "test:all": "npm run bddgen && playwright test",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "Karl Jon Cantor",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "playwright-bdd": "^8.5.0"
  }
}
